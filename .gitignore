# ---------------------------------------------------------------------------
# 秘密与运行态：绝不能入库
# ---------------------------------------------------------------------------
python/service/.secret
python/service/.secret.*
python/service/.admin_password
python/service/*.db
python/service/*.db-wal
python/service/*.db-shm
python/service/logs/
python/service/*.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
python/**/*.egg-info/

# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
web/node_modules/
web/dist/
web/.vite/

# ---------------------------------------------------------------------------
# Rust 构建产物
# ---------------------------------------------------------------------------
rust/target/
proxy/target/
# 构建脚本发布到仓库内的采集器二进制（体积大、可再生）
/bin/

# ---------------------------------------------------------------------------
# 数据与模型产物（数据集体积大、可再生；模型只放行随仓库发布的预置代次）
# ---------------------------------------------------------------------------
traindata/
python/traindata/
# 只放行随仓库发布的预置代次；本地新训练出来的代次仍默认不入库。
python/artifacts/models/*
!python/artifacts/models/supervised/
python/artifacts/models/supervised/*
!python/artifacts/models/supervised/gen-0001-f5da765a27b7/
!python/artifacts/models/supervised/gen-0002-eab7b73e1b04/
!python/artifacts/models/zero_day/
python/artifacts/models/zero_day/*
!python/artifacts/models/zero_day/gen-0001-c3af8fc61410/
!python/artifacts/models/zero_day/gen-0002-1a6967a746ea/
python/artifacts/staging/
python/artifacts/switch_backup/
python/artifacts/curves/
# IP 黑白名单是运行期数据（真值在 console.db），不进仓库
python/artifacts/ip_lists.json

# 模型 / 数据集 / 抓包等二进制
*.onnx
*.joblib
# 预置模型产物（v20 现役 + 零日 warm start 训练件）：克隆后开箱即用
!python/artifacts/xgboost_v20261015_001.onnx
!python/artifacts/iforest_lean_v20261015_001.onnx
!python/artifacts/iforest_model.joblib
!python/artifacts/models/**/*.onnx
!python/artifacts/models/**/*.joblib
*.pkl
*.pickle
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.pcap
*.pcapng
*.cap

# ---------------------------------------------------------------------------
# 日志 / 编辑器 / 系统
# ---------------------------------------------------------------------------
logs/
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
