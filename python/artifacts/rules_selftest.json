   "regex": "(?i)\\$\\{jndi:(ldap|rmi|dns|http)",
   "scopes": [
    "full"
   ],
   "severity": "medium",
   "weight": 1.0,
   "action": "alert",
   "source": "mined"
  },
  {
   "id": "log4shell_lookup",
   "name": "log4shell_lookup",
   "regex": "(?i)\\$\\{(\\$\\{|\\w{1,12}:)",
   "scopes": [
    "full"
   ],
   "severity": "medium",
   "weight": 1.0,
   "action": "alert",
   "source": "mined"
  },
  {
   "id": "ssrf_meta_endpoint",
