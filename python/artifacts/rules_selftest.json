   "scopes": [
    "full"
   ],
   "severity": "medium",
   "weight": 1.0,
   "action": "alert",
   "source": "mined"
  },
  {
   "id": "rce_gateway_probe",
   "name": "rce_gateway_probe",
   "regex": "(?i)/(actuator/(gateway|env|heapdump)|nacos/v1|/druid/index\\.html)",
   "scopes": [
    "full"
   ],
   "severity": "medium",
   "weight": 1.0,
   "action": "alert",
   "source": "mined"
  },
  {
   "id": "selftest_query_scope",
   "name": "SELECT 只在 query 里算",
   "regex": "(?i)\\bselect\\b",
   "scopes": [
    "query"
   ],
   "severity": "low",
   "weight": 1.0,
   "action": "alert",
   "source": "synthetic"
  },
  {
   "id": "selftest_body_scope",
   "name": "<script 只在 body 里算",
   "regex": "(?i)<script",
   "scopes": [
    "body"
   ],
   "severity": "low",
   "weight": 0.5,
   "action": "alert",
   "source": "synthetic"
  },
  {
   "id": "selftest_ua_scope",
